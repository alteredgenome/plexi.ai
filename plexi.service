[Unit]
Description=Plexi AI Executive Assistant
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/plexi
ExecStart=/opt/plexi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
EnvironmentFile=-/opt/plexi/.env

[Install]
WantedBy=multi-user.target
